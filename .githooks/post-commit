#!/bin/sh
# Triggered automatically when the commit message contains [deploy]
MSG=$(git log -1 --pretty=%B)
case "$MSG" in
  *\[deploy\]*)
    echo ""
    echo "==> [deploy] detected — starting production deploy"
    echo ""

    # 1. Build frontend (catch errors before pushing)
    cd "$(git rev-parse --show-toplevel)/frontend" || exit 1
    echo "-- Building frontend..."
    npm run build || { echo "Build failed — aborting deploy"; exit 1; }

    # 2. Push to origin (triggers GitHub Actions for frontend)
    echo "-- Pushing to origin..."
    git -C "$(git rev-parse --show-toplevel)" push origin master || exit 1

    # 3. Deploy backend on VPS
    echo "-- Deploying backend..."
    ssh jarvis@j4rvis.com.br "cd /home/jarvis/recibo42 && make deploy"

    echo ""
    echo "==> Deploy complete"
    ;;
esac
